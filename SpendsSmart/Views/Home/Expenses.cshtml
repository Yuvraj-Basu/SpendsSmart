@{
    ViewData["Title"] = "Expenses";
}
@model List<SpendsSmart.Models.Expense>

<div class="text-center">
    <h1 class="display-4">Expenses</h1>
    <h3>Total Expenses: ₹@ViewBag.TotalExpenses</h3>
    <br/>
    <table class="table"> 
                <thead>
            <tr>
                <th>ID</th>
                <th>Value</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var expense in Model)
            {
                <tr>
                    <td>@expense.Id</td>
                    <td>@expense.Value</td>
                    <td>@expense.Description</td>
                    <td>
                        <a class="btn btn-primary" asp-area="" asp-controller="Home" asp-action="CreateEditExpense" asp-route-id="@expense.Id">Edit</a>
						<a class="btn btn-danger" asp-area="" asp-controller="Home" asp-action="DeleteExpense" asp-route-id="@expense.Id">Delete</a>
                </tr>
            }
        </tbody>
    </table>
</div>
<a class="btn btn-secondary" asp-area="" asp-controller="Home" asp-action="CreateEditExpense">Create New</a>