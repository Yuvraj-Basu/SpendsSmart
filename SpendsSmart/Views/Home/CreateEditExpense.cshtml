@{
    ViewData["Title"] = "Create/Edit";
}

@model SpendsSmart.Models.Expense

<div class="text-center">
    <h1 class="display-4">Create or Edit an Expense</h1>
</div>

<form asp-action="CreateEditExpenseForm" method="post" asp-controller="Home">
    <input hidden asp-for="Id" class="form-control" type="number" placeholder="0" />

    <label class="mt-4">Value ₹</label>
    <input asp-for="Value" class="form-control" type="number" step="0.01" placeholder="0" />

    <label class="mt-4">Description</label>
    <input asp-for="Description" class="form-control" type="text" placeholder="Add a Description" />

    <button type="submit" class="btn btn-primary mt-4">Save</button>
    
</form>